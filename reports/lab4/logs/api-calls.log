"model_version": "baseline-1f8963e78508"
## With the model (MODEL_DIR=artifacts)
$ curl http://127.0.0.1:8000/health
{"status":"ok","model_version":"baseline-1f8963e78508"}
-> HTTP 200

$ curl -X POST http://127.0.0.1:8000/predict -H Content-Type: application/json -d {"season":1,"yr":1,"mnth":3,"hr":8,"holiday":0,"weekday":2,"workingday":1,"weathersit":1,"temp":0.34,"atemp":0.33,"hum":0.55,"windspeed":0.19}
{"prediction":163.77793839037577,"model_version":"baseline-1f8963e78508"}
-> HTTP 200

## Missing field (no windspeed)
$ curl -X POST http://127.0.0.1:8000/predict -H Content-Type: application/json -d {"season":1,"yr":1,"mnth":3,"hr":8,"holiday":0,"weekday":2,"workingday":1,"weathersit":1,"temp":0.34,"atemp":0.33,"hum":0.55}
{"detail":[{"type":"missing","loc":["body","windspeed"],"msg":"Field required","input":{"season":1,"yr":1,"mnth":3,"hr":8,"holiday":0,"weekday":2,"workingday":1,"weathersit":1,"temp":0.34,"atemp":0.33,"hum":0.55}}]}
-> HTTP 422

## Out of range (hr 24)
$ curl -X POST http://127.0.0.1:8000/predict -H Content-Type: application/json -d {"season":1,"yr":1,"mnth":3,"hr":24,"holiday":0,"weekday":2,"workingday":1,"weathersit":1,"temp":0.34,"atemp":0.33,"hum":0.55,"windspeed":0.19}
{"detail":[{"type":"less_than_equal","loc":["body","hr"],"msg":"Input should be less than or equal to 23","input":24,"ctx":{"le":23}}]}
-> HTTP 422

## Wrong type (hr as text)
$ curl -X POST http://127.0.0.1:8000/predict -H Content-Type: application/json -d {"season":1,"yr":1,"mnth":3,"hr":"8","holiday":0,"weekday":2,"workingday":1,"weathersit":1,"temp":0.34,"atemp":0.33,"hum":0.55,"windspeed":0.19}
{"detail":[{"type":"int_type","loc":["body","hr"],"msg":"Input should be a valid integer","input":"8"}]}
-> HTTP 422

## Label as input (cnt)
$ curl -X POST http://127.0.0.1:8000/predict -H Content-Type: application/json -d {"season":1,"yr":1,"mnth":3,"hr":8,"holiday":0,"weekday":2,"workingday":1,"weathersit":1,"temp":0.34,"atemp":0.33,"hum":0.55,"windspeed":0.19,"cnt":5}
{"detail":[{"type":"extra_forbidden","loc":["body","cnt"],"msg":"Extra inputs are not permitted","input":5}]}
-> HTTP 422

